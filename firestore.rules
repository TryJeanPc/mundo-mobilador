rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /mods/{modId} {
      allow read: if true;
      allow create: if isAdmin() && 
                    request.resource.data.keys().hasAll(['title', 'author', 'category', 'version', 'size', 'downloads', 'downloadUrl', 'createdAt', 'createdBy']) &&
                    request.resource.data.title is string &&
                    request.resource.data.author is string &&
                    request.resource.data.category is string &&
                    request.resource.data.version is string &&
                    request.resource.data.size is string &&
                    request.resource.data.downloads is number &&
                    request.resource.data.downloadUrl is string &&
                    request.resource.data.createdAt is number &&
                    request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt']));
      allow delete: if isAdmin();
    }

    match /authors/{authorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /userRoles/{userId} {
      // Users can read their own role. Admins can read all roles.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Only admins can write roles, or a user can create their own role for the first time (setup)
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
  }
}
