{
  "name": "Mundo Mobilador",
  "description": "App for mods with admin-only upload.",
  "roles": {
    "admin": "Can upload, edit, and delete mods.",
    "user": "Can view and download mods."
  },
  "entities": {
    "Mod": {
      "title": "Mod",
      "description": "An uploaded mod APK.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string" },
        "version": { "type": "string" },
        "size": { "type": "string" },
        "downloads": { "type": "number" },
        "videoUrl": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "author", "category", "version", "size", "downloads", "downloadUrl", "createdAt", "createdBy"]
    },
    "Author": {
      "title": "Author",
      "description": "Mod author details.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "socialUrl": { "type": "string" }
      },
      "required": ["name", "category"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "Stores user roles like admin.",
      "type": "object",
      "properties": {
        "isAdmin": { "type": "boolean" }
      },
      "required": ["isAdmin"]
    }
  },
  "firestore": {
    "mods/{modId}": {
      "schema": "Mod",
      "description": "List of mods."
    },
    "authors/{authorId}": {
      "schema": "Author",
      "description": "List of authors."
    },
    "userRoles/{userId}": {
      "schema": "UserRole",
      "description": "User roles and permissions."
    }
  }
}
